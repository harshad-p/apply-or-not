<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.applyornot.relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>--watch</string>
    <string>--watch-preserve-output</string>
    <string>__PROJECT_ROOT__/local-relay/server.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/logs/local-relay.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/logs/local-relay.err.log</string>
</dict>
</plist>
